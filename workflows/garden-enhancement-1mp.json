      "title": "Garden edit instruction",
      "properties": {
        "Node name for S&R": "Note"
      },
      "widgets_values": [
        "Describe changes, not a brand-new scene. Keep explicit preserve clauses. grounding_px 640 is inside the trained 384–768 range and favors edit adherence. The prompt also rejects grain, stippling, painterly texture and haze."
      ],
      "color": "#432",
      "bgcolor": "#653"
    },
